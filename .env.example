# Environment Variables
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/flocci_testimonies?schema=public"

# Flocci OS Integration
FLOCCI_JWKS_URL="https://auth.flocci.in/.well-known/jwks.json"
JWT_SECRET="your-jwt-secret-key-here"

# Logging
LOG_LEVEL=info

# Service Configuration
SERVICE_NAME="flocci-testimonies-srv"
SERVICE_VERSION="1.0.0"

# QR Code Generation
QR_CODE_BASE_URL="https://flocci.in/testimonies"

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=10
